# SYRIA AI platform — environment template
# Copy to .env and adjust for your machine.

# Prisma SQLite database (relative path works from the project root)
DATABASE_URL="file:./db/custom.db"

# ---- SYRIA AI neural engine (FastAPI service, syria-ai-core) --------------

# Optional: where the SYRIA AI neural core (Python package) lives.
# Defaults to <project-root>/syria-ai-core
# NEURAL_CORE_ROOT="/absolute/path/to/syria-ai-core"

# Optional: explicit Python interpreter that has torch + fastapi + uvicorn.
# Useful when the scientific stack lives in a virtualenv. If unset, the
# platform probes `python3` / `python3.x` on PATH automatically.
# NEURAL_PYTHON="/absolute/path/to/python"

# Optional: base URL of the neural inference service.
# Default: http://127.0.0.1:3010
# Override for standalone / sidecar / Docker deployments, e.g.:
# NEURAL_SERVICE_URL="http://neural:3010"

# Lifecycle control (production-safe):
#   NEURAL_AUTOSTART=1 (default, development) — the platform starts the Python
#     service once, lazily, and reuses it; it never spawns per request.
#   NEURAL_AUTOSTART=0 (recommended for production) — the platform NEVER
#     spawns anything; it only probes NEURAL_SERVICE_URL and reports an honest
#     MODEL_NOT_READY while the service is down. Run the service yourself
#     (systemd / Docker / k8s):
#       python -m uvicorn syria_ai.inference.service:app --host 0.0.0.0 --port 3010
# NEURAL_AUTOSTART=0
