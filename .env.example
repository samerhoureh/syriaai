# SYRIA AI platform — environment template
# Copy to .env and adjust for your machine.

# Prisma SQLite database (relative path works from the project root)
DATABASE_URL="file:./db/custom.db"

# Optional: where the SYRIA AI neural core (Python package) lives
# Defaults to <project-root>/syria-ai-core
# NEURAL_CORE_ROOT="/absolute/path/to/syria-ai-core"

# Optional: port of the SYRIA AI inference service (default 3010)
# NEURAL_PORT=3010
