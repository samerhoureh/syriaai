# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug logs
*.log

# env files (never commit secrets — the template .env.example IS published)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local reverse-proxy config (deployment-specific, not part of the source)
Caddyfile

# local tooling / scratch files
/skills/
/tests/
/upload/
/download/

# runtime databases (prisma sqlite — regenerated per deployment)
/db/

# python neural engine
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# local sqlite database (created by prisma db push)
/db/
tool-results/ >> .gitignore
